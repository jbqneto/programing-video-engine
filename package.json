{
  "name": "video-production-engine-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative engine for cinematic videos and 3D motion graphics",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "assets": "node scripts/assets.mjs",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "demo": "npm run smoke && npm run test && npm run validate && npm run typecheck && npm run render -- --out out/afterhours-demo.mp4",
    "ui": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "mcp:stdio": "tsx scripts/mcp/stdio.ts",
    "mcp:http": "tsx scripts/mcp/http.ts",
    "mcp:check": "tsx scripts/mcp/check.ts",
    "workbench": "node scripts/workbench.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@remotion/three": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
