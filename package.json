{
  "name": "video-production-engine-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative engine for cinematic videos and 3D motion graphics",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "assets": "node scripts/assets.mjs",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "demo": "npm run smoke && npm run test && npm run validate && npm run typecheck && npm run render -- --out out/afterhours-demo.mp4",
    "ui": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "mcp:stdio": "tsx scripts/mcp/stdio.ts",
    "mcp:http": "tsx scripts/mcp/http.ts",
    "mcp:check": "tsx scripts/mcp/check.ts",
    "workbench": "node scripts/workbench.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "skills": "node scripts/skills.mjs",
    "skills:check": "node scripts/skills.mjs check",
    "quality": "tsx scripts/quality/cli.ts",
    "quality:smoke": "node scripts/quality/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@remotion/cli": "4.0.541",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
